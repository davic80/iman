# Copia a .env en el servidor. Ninguno de estos valores es un secreto.

# Red Docker donde vive el Caddy compartido. Averíguala con:
#   docker inspect cloud-caddy-1 \
#     --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
PROXY_NETWORK=cloud_default

# Imagen a levantar. Para volver atrás, pon aquí el SHA de un commit bueno.
IMAN_TAG=latest
